# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Google Sheets
GOOGLE_SHEET_ID=your-spreadsheet-id-from-url
GOOGLE_SHEET_NAME=Sheet1
